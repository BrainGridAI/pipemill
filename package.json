{
  "name": "pipemill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pipemill - the open-source GTM factory. Pipeline, milled.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
